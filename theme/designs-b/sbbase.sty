% ---------------------------------------------------------------- text
\newcommand{\term}[1]{\textbf{\color{termColor}#1}}
\newcommand{\sbcaps}[2][80]{\textls[#1]{\MakeUppercase{#2}}}
\def\sbinf{011010010110111001100110}
\def\sbschool{011100110110001101101000011011110110111101101100}
\newcommand{\sbnocopy}[1]{\BeginAccSupp{method=plain,ActualText={}}#1\EndAccSupp{}}
\setlength{\parskip}{0.45\baselineskip}

% deck metadata
\newcommand{\sbsubject}{Algorithmik}
\newcommand{\sbchapter}{3}
\newcommand{\setsubject}[1]{\renewcommand{\sbsubject}{#1}}
\newcommand{\setchapter}[1]{\renewcommand{\sbchapter}{#1}}
\newcommand{\sbsecnum}{\sbchapter.\insertsectionnumber}
% kicker line: «3.2 Selectionsort», before the first section «Algorithmik · Kapitel 3»
\DeclareRobustCommand{\sbsep}{\ \mbox{\textls[0]{\textperiodcentered}}\ }  % in letterspaced capitals
\newcommand{\sbsecline}{\ifnum\value{section}=0 \sbsubject\sbsep Kapitel \sbchapter\else\sbsecnum\enspace\insertsectionhead\fi}
% number for hexagons: 3.2, before the first section just 3
\newcommand{\sbhexnum}{\ifnum\value{section}=0 \sbchapter\else\sbsecnum\fi}
\newcommand{\sbnohyph}{\hyphenchar\font=-1 \raggedright}
\newcommand{\sbphotos}{}
\newcommand{\setphotos}[1]{\renewcommand{\sbphotos}{#1}}
% n-th photo of the list (1-based) into \sbphoto
\newcommand{\sbgetphoto}[1]{\gdef\sbphoto{}\foreach \f [count=\j] in \sbphotos {\ifnum\j=#1\relax\xdef\sbphoto{\f}\fi}}

% ---------------------------------------------------------------- icons
% open book: «Zum Lesen» (same 24-unit grid and stroke as slideicons.sty)
\makeatletter
\@namedef{boxicon@book}{%
  \draw (12,5.5) .. controls (9.5,7.2) and (6.5,7.6) .. (2.5,7)
        -- (2.5,18.5) .. controls (6.5,19.1) and (9.5,18.7) .. (12,17)
        .. controls (14.5,18.7) and (17.5,19.1) .. (21.5,18.5)
        -- (21.5,7) .. controls (17.5,7.6) and (14.5,7.2) .. (12,5.5) -- cycle;
  \draw (12,5.5) -- (12,17);}
\makeatother
% icon in a hexagon, inline: \sbiconhex[fill][rim]{icon}{size}
\NewDocumentCommand{\sbiconhex}{O{hexFill} O{hexRim} m m}{%
  \tikz[baseline=-0.6ex]{\node[phex=#4, fill=#1, draw=#2, line width=\designRim] (h) {};
    \pic at (h.center) {boxicon={#3}{0.7*#4}};}}

% ---------------------------------------------------------------- lists
\setbeamertemplate{itemize item}{\raisebox{0.12ex}{\tikz\node[hex=2.1mm, fill=termColor]{};}}
\setbeamertemplate{itemize subitem}{\raisebox{0.2ex}{\tikz\node[hex=1.7mm, draw=termColor, line width=0.6pt]{};}}
\setbeamertemplate{enumerate item}{\tikz[baseline=(n.base)]\node[phex=5.6mm, fill=hexFill,
  draw=hexRim, line width=0.3mm, text=white, font=\footnotesize\bfseries] (n) {\insertenumlabel};}
\setlength{\leftmargini}{1.4em}
\setlength{\leftmarginii}{1.3em}
\setbeamerfont{itemize/enumerate subbody}{size=\normalsize}
\setbeamercolor{itemize/enumerate subbody}{fg=mutedFg}
\addtobeamertemplate{itemize/enumerate body begin}{}{\setlength{\itemsep}{0.35\baselineskip}}

% ---------------------------------------------------------------- modes
% \begin{frame}[machmit={zu zweit · 15 Min}]{...}   class works now
% \begin{frame}[lesen={Skript S. 92}]{...}          read, don't copy
\newif\ifsbmachmit
\newif\ifsblesen
\newif\ifsbspecial   % title/section frames: no chrome
\gdef\sbtag{}
\BeforeBeginEnvironment{frame}{\global\sbmachmitfalse\global\sblesenfalse\global\sbspecialfalse}
\makeatletter
\define@key{beamerframe}{machmit}{\global\sbmachmittrue\gdef\sbtag{#1}}
\define@key{beamerframe}{lesen}{\global\sblesentrue\gdef\sbtag{#1}}
\define@key{beamerframe}{special}[true]{\global\sbspecialtrue}
\makeatother
\newif\ifsbmode
\newcommand{\sbmodecheck}{\sbmodefalse\ifsbmachmit\sbmodetrue\fi\ifsblesen\sbmodetrue\fi}
\newcommand{\sbmodeicon}{\ifsbmachmit task\else book\fi}
\newcommand{\sbmodename}{\ifsbmachmit Mach mit\else Zum Lesen\fi}
\newcommand{\sbmodecol}{\ifsbmachmit doCol\else readCol\fi}
\newcommand{\sbmoderim}{\ifsbmachmit termColor\else readRim\fi}
\newcommand{\sbmodetext}{\ifsbmachmit termColor\else readText\fi}

% ---------------------------------------------------------------- photo hexagons
% \sbphotohex[extra node options]{coordinate}{size}{image}: duotone as on the
% scripts' cover (grey levels of the photo times a light tint)
\newsavebox{\sbimgbox}
\newcommand{\sbcoverimage}[3]{%
  \sbox{\sbimgbox}{\includegraphics{#1}}%
  \pgfmathsetmacro{\sbscale}{max((#2)/\wd\sbimgbox, (#3)/\ht\sbimgbox)}%
  \includegraphics[scale=\sbscale]{#1}}
% without a photo (subject has no cover images yet): an empty hexagon
\NewDocumentCommand{\sbphotohex}{O{} m m m O{1.2mm}}{\edef\sbphotofile{#4}\ifdefempty{\sbphotofile}%
  {\node[hex=#3, fill=hexFill, draw=hexRim, line width=#5, #1] at (#2) {};}{%
  \node[hex=#3, fill=white, #1, path picture={
      \begin{scope}[blend mode=luminosity]
        \node[inner sep=0pt] at (path picture bounding box.center)
          {\sbcoverimage{#4}{#3}{#3}};
      \end{scope}
      \begin{scope}[blend mode=multiply]
        \fill[coverTint] (path picture bounding box.south west)
          rectangle (path picture bounding box.north east);
      \end{scope}}] at (#2) {};
  \node[hex=#3, draw=borderColor, line width=#5, #1] at (#2) {};}}

% ---------------------------------------------------------------- boxes
\newcommand{\boxtitle}[1]{\sbcaps{#1}}
% concept: title bar, icon hexagon at the top right
\newtcolorbox{sbtitlebox}[3][]{enhanced, colback=boxBg, colbacktitle=boxTitleBg,
  colframe=borderColor, boxrule=\designBoxRule, leftrule=1pt, rightrule=1pt,
  arc=\designArc, coltitle=white, fonttitle=\bfseries\normalsize,
  toptitle=0.8mm, bottomtitle=0.8mm, left=3mm, right=3mm, top=1.5mm, bottom=1.5mm,
  title={\boxtitle{#2}}, before skip=2mm, after skip=3mm, coltext=textFg,
  overlay={\node[phex=\sbIconHex, fill=hexFill, draw=hexRim, line width=\designRim, anchor=north]
    (hex) at ([xshift=-8mm, yshift=1.6mm]frame.north east) {};
    \pic at (hex.center) {boxicon={#3}{\sbIconGlyph}};}, #1}
\newenvironment{concept}[1][]{\begin{sbtitlebox}{#1}{bulb}}{\end{sbtitlebox}}
\newenvironment{info}[1][]{\begin{sbtitlebox}{#1}{info}}{\end{sbtitlebox}}
% task/example: left rule, icon hexagon on the rule
\newtcolorbox{sbmarkleft}[3][]{enhanced, boxrule=0pt, frame hidden, colback=pageBg,
  borderline west={\designLeftRule}{0pt}{borderColor}, arc=0pt, outer arc=0pt,
  left=6.5mm, right=2mm, top=1mm, bottom=1.5mm, coltext=textFg, before skip=3mm, after skip=3mm,
  overlay={\node[phex=\sbIconHexLeft, fill=hexFill, draw=hexRim, line width=\designRim, anchor=north]
    (hex) at ([xshift=0.5\designLeftRule, yshift=1mm]frame.north west) {};
    \pic at (hex.center) {boxicon={#3}{\sbIconGlyphLeft}};},
  #1}
\newenvironment{task}[2]{\begin{sbmarkleft}{#2}{task}%
  {\bfseries\color{termColor}\boxtitle{Aufgabe #1:}} {\bfseries\boxtitle{#2}}\par\smallskip}
  {\end{sbmarkleft}}

% numbered steps of an algorithm: \sbstep{1}{text}, \sbstep[hl]{2}{text}
\tcbset{
  sbstep/.style={enhanced, frame hidden, arc=\designArc, boxrule=0pt,
    left=10mm, right=2mm, top=1.2mm, bottom=1.2mm, before skip=1mm, after skip=1mm,
    coltext=textFg, colback=pageBg, before upper=\raggedright},
  sbstep hl/.style={sbstep, colback=boxBg, borderline west={1.2mm}{0pt}{termColor}},
  sbstep hex/.style 2 args={overlay={\node[phex=6.4mm, fill=#1, draw=hexRim,
    line width=0.3mm, text=#2, font=\small\bfseries, anchor=north west]
    at ([xshift=2mm, yshift=-0.6mm]frame.north west) {\sbstepnum};}},
}
\ifsbdark\definecolor{stepHlText}{HTML}{2A1A24}\else\colorlet{stepHlText}{white}\fi
\NewDocumentCommand{\sbstep}{o m m}{\def\sbstepnum{#2}%
  \IfValueTF{#1}%
    {\begin{tcolorbox}[sbstep hl, sbstep hex={termColor}{stepHlText}]#3\end{tcolorbox}}%
    {\begin{tcolorbox}[sbstep, sbstep hex={hexFill}{white}]#3\end{tcolorbox}}}

% ---------------------------------------------------------------- code
\lstdefinestyle{sbpython}{language=Python, basicstyle=\ttfamily\normalsize\color{textFg},
  keywordstyle=\bfseries\color{codeKey}, commentstyle=\itshape\color{codeComment},
  stringstyle=\color{codeStr}, emph={range,len,print}, emphstyle=\color{codeBuiltin},
  numbers=left, numberstyle=\ttfamily\footnotesize\color{mutedFg}, numbersep=3mm,
  showstringspaces=false, columns=fullflexible, keepspaces=true, upquote=true,
  literate={ä}{{\"a}}1 {ö}{{\"o}}1 {ü}{{\"u}}1}
% \begin{codebox}{file.py} ... \end{codebox} (frame must be fragile)
\newtcblisting{codebox}[2][]{enhanced, listing only, colback=codeBg, colframe=borderColor,
  colbacktitle=boxTitleBg, coltitle=white, boxrule=\designBoxRule, arc=\designArc,
  title={\hspace{8mm}\ttfamily\normalsize #2}, fonttitle=\normalsize, toptitle=0.8mm, bottomtitle=0.8mm,
  left=9mm, top=1mm, bottom=1mm,
  listing options={style=sbpython},
  overlay={\node[phex=7.5mm, fill=hexFill, draw=hexRim, line width=\designRim]
    (hex) at ([xshift=4.5mm]title.west) {};
    \pic at (hex.center) {boxicon={python}{5.3mm}};}, #1}

% ---------------------------------------------------------------- pitch page
% \sbpitch{idea}{Eigenschaften items}{Stärken items}{Schwächen items}{wenn ...}
\newcommand{\sbpitchhead}[1]{{\bfseries\color{termColor}\sbcaps{#1}}\par\vspace{0.5mm}}
\newenvironment{sbplist}{\begin{list}{\usebeamertemplate{itemize item}}{%
  \setlength{\leftmargin}{1.1em}\setlength{\labelsep}{0.45em}\setlength{\itemsep}{0.6mm}%
  \setlength{\parsep}{0pt}\setlength{\topsep}{0pt}\small}}{\end{list}}
\newcommand{\sbpitch}[5]{%
  {\bfseries\raggedright #1\par}\vspace{1mm}
  \begin{columns}[T,onlytextwidth]
    \begin{column}{0.4\textwidth}\small\raggedright
      \sbpitchhead{Eigenschaften}
      \begin{sbplist}#2\end{sbplist}
    \end{column}
    \begin{column}{0.28\textwidth}\small\raggedright
      \sbpitchhead{Stärken}
      \begin{sbplist}#3\end{sbplist}
    \end{column}
    \begin{column}{0.28\textwidth}\small\raggedright
      \sbpitchhead{Schwächen}
      \begin{sbplist}#4\end{sbplist}
    \end{column}
  \end{columns}
  \vspace{2mm}{\small\raggedright\textbf{\color{termColor}Nimm dieses Design, wenn} #5\par}}

% small pill with text: \sbpill{fill}{text colour}{text}
\newcommand{\sbpill}[3]{\tikz[baseline=(p.base)]\node[fill=#1, text=#2, rounded corners=1.2mm,
  inner xsep=2mm, inner ysep=1mm, font=\footnotesize\bfseries] (p) {#3};}
