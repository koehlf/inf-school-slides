% sbbase.sty -- shared base of the five comparison designs B1-B5
% (designer B). Palette (light/dark), fonts, design tokens, box icons,
% boxes, code box, lists, the two slide modes and helpers. The chrome
% (title area, page number, title and section slides) lives in sbB<n>.sty.
%
% Palette switch: \def\slidepalette{dark} before \documentclass
% (latexmk -usepretex='\def\slidepalette{dark}'); default is light.
\ProvidesPackage{sbbase}
\providecommand{\slidepalette}{light}

% ---------------------------------------------------------------- packages
\usefonttheme{professionalfonts}
\RequirePackage[T1]{fontenc}
\RequirePackage[sfdefault]{FiraSans}
\RequirePackage[lining,scaled=0.94]{FiraMono}
\RequirePackage{newtxsf}
\RequirePackage[ngerman]{babel}
\AtBeginDocument{\shorthandoff{"}}  % TikZ edge quotes: edge["5"]
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{xparse}
\RequirePackage{accsupp}
\RequirePackage{tikz}
\usetikzlibrary{babel,positioning,shapes.geometric,shapes.misc,calc,arrows.meta,quotes,decorations.pathreplacing}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}

