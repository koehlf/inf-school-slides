% sbB1.sty -- design B1 «Band»: the scripts' page chrome on a slide.
% Dark header band with light rules, chapter hexagon hanging from the top
% left corner, page number hexagon on a thin footer band. Cover with the
% scripts' honeycomb, section slide as the scripts' chapter banner.
% Modes recolour the band and hang an icon hexagon at its right end.
\ProvidesPackage{sbB1}
\RequirePackage{sbbase}

\setbeamersize{text margin left=10mm, text margin right=10mm}
\newcommand{\sbBandH}{11mm}
\newcommand{\sbFootH}{4.5mm}

\setbeamertemplate{headline}{}
\setbeamertemplate{frametitle}{\vbox to 9mm{}}
\setbeamertemplate{footline}{\vbox to 7mm{}}

\setbeamertemplate{background}{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
    \ifsbspecial\else
    \sbmodecheck
    \ifsbmachmit\colorlet{band}{doCol}\colorlet{bandrule}{primaryDark}\fi
    \ifsblesen\colorlet{band}{readCol}\colorlet{bandrule}{readRim}\fi
    \ifsbmode\else\colorlet{band}{bandBg}\colorlet{bandrule}{bandRule}\fi
    % header band
    \fill[band] (0,\paperheight-\sbBandH) rectangle (\paperwidth,\paperheight);
    \fill[bandrule] (0,\paperheight-\sbBandH) rectangle (\paperwidth,\paperheight-\sbBandH+\designBandRule);
    \fill[bandrule] (0,\paperheight) rectangle (\paperwidth,\paperheight-\designBandRule);
    % chapter hexagon
    \node[hex=15mm, fill=band, draw=bandrule, line width=\designRim, text=white,
      font=\bfseries\Large] at (8mm,\paperheight-6.2mm) {\sbchapter};
    % title
    \node[anchor=west, text=white, font=\bfseries\Large, inner sep=0pt] (tt)
      at (17.5mm,\paperheight-0.5*\sbBandH-0.3mm) {\insertframetitle};
    % binary text after the title, covered by the label on the right
    \begin{scope}
      \clip (0,\paperheight-\sbBandH+\designBandRule) rectangle (\paperwidth-40mm,\paperheight-\designBandRule);
      \node[anchor=west, text=band!80!white, font=\ttfamily\bfseries\Large]
        at ([xshift=6mm]tt.east) {\sbnocopy{\textls[100]{\sbinf\sbschool}}};
    \end{scope}
    \ifsbmode
      \node[hex=15mm, fill=band, draw=bandrule, line width=\designRim] (mh)
        at (\paperwidth-9mm,\paperheight-6.2mm) {};
      \pic at (mh.center) {boxicon={\sbmodeicon}{8.5mm}};
      \node[anchor=east, text=white, font=\small, fill=band, inner xsep=3mm, inner ysep=1.5mm]
        at (\paperwidth-16mm,\paperheight-0.5*\sbBandH-0.3mm)
        {\textbf{\sbcaps{\sbmodename}}\enspace·\enspace\sbtag};
    \else
      \node[anchor=east, text=white, font=\small, fill=band, inner xsep=3mm, inner ysep=1.5mm]
        at (\paperwidth-7mm,\paperheight-0.5*\sbBandH-0.3mm) {\insertsectionhead};
    \fi
    % footer band and page number
    \fill[bandBg] (0,0) rectangle (\paperwidth,\sbFootH);
    \fill[bandRule] (0,\sbFootH) rectangle (\paperwidth,\sbFootH-\designBandRule);
    \pic at (10mm,1.35mm) {infschool logo={font=\scriptsize, text=white, fill=bandBg, rim=bandRule}};
    \node[hex=8.5mm, fill=bandBg, draw=bandRule, line width=\designRim, text=white,
      font=\bfseries\footnotesize] at (\paperwidth-14mm,\sbFootH) {\insertframenumber};
    \fi
  \end{tikzpicture}}

% ---------------------------------------------------------------- title slide
\newcommand{\sbtitleframe}{%
\begin{frame}[plain,special]
  \begin{tikzpicture}[remember picture, overlay]
    \fill[primaryDark] (current page.south west) rectangle (current page.north east);
    % honeycomb: columns 27.5 mm apart, rows 31 mm, odd columns half a row down
    \def\hs{34mm}
    \foreach \x/\y/\n in {93/78/0, 120.5/62.5/1, 148/78/2, 93/16/0, 120.5/31.5/3,
        148/47/4, 148/16/5, 175.5/31.5/0, 175.5/62.5/6, 120.5/93.5/0, 175.5/0.5/0} {
      \coordinate (c) at ([xshift=\x mm, yshift=\y mm]current page.south west);
      \ifnum\n=0
        \node[hex=\hs, fill=coverDark, draw=borderColor!35!primaryDark, line width=1mm] at (c) {};
      \else
        \sbgetphoto{\n}\sbphotohex{c}{\hs}{\sbphoto}[1mm]
      \fi}
    \coordinate (bar) at ([xshift=10mm, yshift=60mm]current page.south west);
    \fill[borderColor, rounded corners=0.4mm] (bar) rectangle ++(12mm,-1.2mm);
    \node[anchor=north west, inner sep=0pt, text=white, font=\bfseries\fontsize{36}{40}\selectfont]
      (t) at ([yshift=-4mm]bar) {\inserttitle};
    \node[anchor=north west, inner sep=0pt, text=coverText, font=\large]
      (s) at ([yshift=-4mm]t.south west) {\insertsubtitle};
    \node[anchor=north west, inner sep=0pt, text=coverTint, font=\small\bfseries]
      at ([yshift=-6mm]s.south west) {\sbcaps[150]{\sbsubject\sbsep Kapitel \sbchapter}};
    % footer band
    \fill[coverDark] (current page.south west) rectangle ([yshift=9mm]current page.south east);
    \fill[borderColor] ([yshift=9mm]current page.south west) rectangle ([yshift=9mm-\designBandRule]current page.south east);
    \node[anchor=west, text=white, font=\normalsize] at ([xshift=10mm, yshift=4.5mm]current page.south west) {\insertauthor};
    \pic at ([xshift=-10mm, yshift=3.2mm]current page.south east)
      {infschool logo={align=right, font=\large, text=white, fill=coverDark, rim=borderColor}};
  \end{tikzpicture}
\end{frame}}

% ---------------------------------------------------------------- section slide
\newcommand{\sbsectionframe}[1]{%
\begin{frame}[plain,special]
  \begin{tikzpicture}[remember picture, overlay]
    \coordinate (sw) at (current page.south west);
    \node[anchor=west, text=mutedFg, font=\small\bfseries] at ([xshift=10mm, yshift=66mm]sw)
      {\sbcaps[150]{Kapitel \sbchapter\sbsep \inserttitle}};
    \fill[bandBg] ([yshift=26mm]sw) rectangle ([yshift=58mm]current page.south east);
    \fill[bandRule] ([yshift=58mm]sw) rectangle ([yshift=56.8mm]current page.south east);
    \fill[bandRule] ([yshift=26mm]sw) rectangle ([yshift=27.2mm]current page.south east);
    \node[anchor=base west, inner sep=0pt, text=white, font=\bfseries\fontsize{30}{34}\selectfont]
      at ([xshift=10mm, yshift=43mm]sw) {\insertsectionhead};
    \node[anchor=base west, inner sep=0pt, text=coverText, font=\large]
      at ([xshift=10mm, yshift=33mm]sw) {«#1»};
    \node[hex=40mm, fill=bandBg, draw=bandRule, line width=1.6mm, text=white,
      font=\bfseries\fontsize{34}{38}\selectfont] at ([xshift=128mm, yshift=48mm]sw) {\sbsecnum};
    \fill[bandBg] (sw) rectangle ([yshift=\sbFootH]current page.south east);
    \fill[bandRule] ([yshift=\sbFootH]sw) rectangle ([yshift=\sbFootH-\designBandRule]current page.south east);
  \end{tikzpicture}
\end{frame}}
