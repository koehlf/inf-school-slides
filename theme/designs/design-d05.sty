% D05 «Karte» (review V4): content on a card, like a script box on a tinted page
\ProvidesPackage{design-d05}
\renewcommand{\designnumber}{D05}
\renewcommand{\designname}{Karte}
\renewcommand{\designidea}{Der Inhalt liegt auf einer Karte mit runden Ecken, wie eine Box im Skript. Der Titel steht darüber auf der getönten Seite.}
\renewcommand{\designprops}{%
  \item getönte Seite, Inhalt auf einer Karte
  \item Titel mit Sechseck-Punkt über der Karte
  \item Seitenzahl auf der Ecke der Karte}
\renewcommand{\designpros}{%
  \item ruhig und modern
  \item klarer Inhaltsbereich}
\renewcommand{\designcons}{%
  \item Rand kostet rundum 7\,mm
  \item Box auf Karte: doppelte Rahmen}
\renewcommand{\designpick}{die Folien ruhig und aufgeräumt wirken sollen.}

