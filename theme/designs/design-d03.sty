% D03 «Seitenleiste» (review V2): dark strip on the left, like the edge of a script cover
\ProvidesPackage{design-d03}
\renewcommand{\designnumber}{D03}
\renewcommand{\designname}{Seitenleiste}
\renewcommand{\designidea}{Eine dunkle Leiste links trägt Kapitel, Waben und Seitenzahl.}
\renewcommand{\designprops}{%
  \item Leiste 15\,mm mit Kapitel und Waben
  \item Titel ohne Band, kurzer Farbstrich
  \item Modus: Leiste wird hell}
\renewcommand{\designpros}{%
  \item volle Höhe für Grafiken
  \item Marke gut sichtbar, auch dunkel}
\renewcommand{\designcons}{%
  \item kostet 10\,\% der Breite
  \item neu, nicht aus dem Skript}
\renewcommand{\designpick}{Grafiken die Hauptsache sind und die Marke trotzdem klar bleiben soll.}

