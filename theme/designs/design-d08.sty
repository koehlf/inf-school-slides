% D08 «Spalte» (new): the title lives in a dark column on the left, the content on the right
\ProvidesPackage{design-d08}
\renewcommand{\designnumber}{D08}
\renewcommand{\designname}{Spalte}
\renewcommand{\designidea}{Eine dunkle Titelspalte links trägt Kapitel, Abschnitt, Titel und Seitenzahl. Rechts bleibt die volle Höhe für den Inhalt.}
\renewcommand{\designprops}{%
  \item Spalte 40\,mm, Titel darf umbrechen
  \item Abschnitt und Kapitel oben in der Spalte
  \item Modus: Spalte wird hell, mit grossem Symbol}
\renewcommand{\designpros}{%
  \item lange Titel kein Problem
  \item volle Höhe, sehr markant}
\renewcommand{\designcons}{%
  \item nur 70\,\% der Breite für Inhalt
  \item breite Grafiken werden kleiner}
\renewcommand{\designpick}{Folien eher hoch als breit sind: Text, Code, Schritte.}

