% D07 «Kapitel» (new): no band; a large chapter hexagon in the corner, title on a rule
\ProvidesPackage{design-d07}
\renewcommand{\designnumber}{D07}
\renewcommand{\designname}{Kapitel}
\renewcommand{\designidea}{Kein Band: ein grosses Kapitel-Sechseck oben links, der Titel auf einer feinen Linie, die in der Seitenzahl endet.}
\renewcommand{\designprops}{%
  \item Kapitel-Sechseck 16\,mm
  \item Abschnitt als Überzeile über dem Titel
  \item Modus: Symbol statt Kapitelnummer}
\renewcommand{\designpros}{%
  \item hell und offen, wenig Fläche
  \item man sieht immer, wo man im Deck ist}
\renewcommand{\designcons}{%
  \item Titelzone 18\,mm hoch
  \item im Hellen weniger «Skript-Band»}
\renewcommand{\designpick}{du das Sechseck als Marke willst, aber keine Bänder.}

