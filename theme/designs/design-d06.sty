% D06 «Klartext» (review V5): classroom first, 14 pt, a colour bar and almost no chrome
\ProvidesPackage{design-d06}
\renewcommand{\designnumber}{D06}
\renewcommand{\designname}{Klartext}
\renewcommand{\designidea}{Lesbarkeit zuerst: 14\,pt Grundschrift, grosser Titel, ein Farbstreifen links. Sonst nichts.}
\renewcommand{\designprops}{%
  \item 14\,pt statt 12\,pt
  \item Streifen 3\,mm links, Seitenzahl als Text
  \item Modus: Streifen wird breit, mit Symbol}
\renewcommand{\designpros}{%
  \item am besten lesbar, am meisten Platz
  \item am einfachsten über 80 Decks}
\renewcommand{\designcons}{%
  \item wenig «inf.school» auf Inhaltsfolien
  \item weniger Text pro Folie}
\renewcommand{\designpick}{die hinterste Reihe alles lesen können soll.}

