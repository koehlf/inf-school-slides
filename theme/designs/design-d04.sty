\renewcommand{\designidea}{Das bisherige Impress-Master in neuer Farbe: drei Waben oben links, eine Netzlinie mit Punkten unter dem Titel.}
\renewcommand{\designprops}{%
  \item drei Waben, die erste mit der Kapitelnummer
  \item Netzlinie unter dem Titel, Titel leicht
  \item Binärzahl unten links, Seitenzahl unten rechts}
\renewcommand{\designpros}{%
  \item Klassen erkennen die alten Folien wieder
  \item luftig, ohne schwere Flächen}
\renewcommand{\designcons}{%
  \item unruhigste Dekoration der zehn
  \item leichter Titel wirkt von hinten schwächer}
\renewcommand{\designpick}{der Wechsel für die Klassen möglichst sanft sein soll.}

